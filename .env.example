# Environment template. Committed; contains no secrets and never should.
#
# ---------------------------------------------------------------------------
# WHERE THE REAL FILE GOES:  ~/.config/mva/env
# ---------------------------------------------------------------------------
# That is your WSL **home directory** -- /home/<you>/.config/mva/env -- NOT a
# folder inside this project. If a `config/mva/` directory ever appears in the
# repo, the `~` was resolved as a relative path; move it and delete it.
#
# It lives outside the repository deliberately. Credentials inside the repo tree
# get picked up by editors, file-watchers and agents that read changed files; a
# path outside the tree removes that channel entirely rather than relying on
# .gitignore to hold the line.
#
#   mkdir -p ~/.config/mva && chmod 700 ~/.config/mva
#   cp .env.example ~/.config/mva/env      # then edit it there
#   chmod 600 ~/.config/mva/env
#
# Load before any download or pipeline run:
#
#   set -a; . ~/.config/mva/env; set +a
#
# See docs/data_custody.md for why the cache variables below matter.

# ---------------------------------------------------------------------------
# Data custody root -- ALL patient-derived bytes live under this one tree.
# ---------------------------------------------------------------------------
# Must be on WSL-native ext4, NOT under /mnt/... and NOT inside this repository.
# Outside the repo, git cannot reach it even if .gitignore were broken; on ext4,
# random-access reads avoid the slow Windows filesystem bridge.
# Registered as location C1 in docs/data_custody.md.
MVA_DATA_ROOT=/home/CHANGEME/mva-data

# ---------------------------------------------------------------------------
# Hugging Face cache -- set BEFORE the first download, not after.
# ---------------------------------------------------------------------------
# Left unset, the Hub caches to ~/.cache/huggingface, OUTSIDE the custody root:
# real bytes in blobs/ (snapshots/ holds only symlinks), xet chunk caches, and
# .incomplete partials from interrupted downloads. All of it would escape a
# purge scoped to MVA_DATA_ROOT. Pointing HF_HOME inside the custody root puts
# every cache surface in one registered tree.
# Registered as location C2 in docs/data_custody.md.
HF_HOME=/home/CHANGEME/mva-data/hf-cache

# ---------------------------------------------------------------------------
# Credentials -- real values only in ~/.config/mva/env, never here.
# ---------------------------------------------------------------------------
# Fine-grained token, scoped to read contents of the one gated dataset repo.
# Do not grant user-level or org-level permissions; the repo-scoped grant is
# sufficient and keeps the blast radius to a dataset you already have access to.
HF_TOKEN=

# Used by the L3 Claude-in-the-loop reasoning step.
ANTHROPIC_API_KEY=
