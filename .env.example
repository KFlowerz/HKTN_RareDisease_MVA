# Environment template -- copy to `.env` and fill in. `.env` is gitignored; this file is not.
# NEVER put a real token in this file. NEVER commit `.env`.
#
#     cp .env.example .env    # then edit .env
#
# These are exported into the shell before any download or pipeline run:
#
#     set -a; . ./.env; set +a
#
# See docs/data_custody.md for why the cache variables below matter.

# ---------------------------------------------------------------------------
# Data custody root -- ALL patient-derived bytes live under this one tree.
# ---------------------------------------------------------------------------
# Must be on WSL-native ext4, NOT under /mnt/... and NOT inside this repository.
# Outside the repo, git cannot reach it even if .gitignore were broken; on ext4,
# random-access BAM reads avoid the slow Windows filesystem bridge.
# Registered as location C1 in docs/data_custody.md.
MVA_DATA_ROOT=/home/CHANGEME/mva-data

# ---------------------------------------------------------------------------
# Hugging Face cache -- set BEFORE the first download, not after.
# ---------------------------------------------------------------------------
# Left unset, the Hub caches to ~/.cache/huggingface, OUTSIDE the custody root:
# real bytes in blobs/ (snapshots/ holds only symlinks), xet chunk caches, and
# .incomplete partials from interrupted downloads. All of it would escape a
# purge scoped to MVA_DATA_ROOT. Pointing HF_HOME inside the custody root puts
# every cache surface in one registered tree.
# Registered as location C2 in docs/data_custody.md.
HF_HOME=/home/CHANGEME/mva-data/hf-cache

# ---------------------------------------------------------------------------
# Credentials -- real values only in `.env`, never here, never in a commit.
# ---------------------------------------------------------------------------
# Gated-dataset access token (read scope is sufficient).
HF_TOKEN=

# Used by the L3 Claude-in-the-loop reasoning step.
ANTHROPIC_API_KEY=
